# >>> Vibrance
# Vibrance and Vibrance MusicLib: settings of compose.yaml. Copy this file to
# `.env` next to compose.yaml, set POSTGRES_PASSWORD, MUSICLIB_PASSWORD and
# VIBRANCE_ADMIN_PASSWORD, then `chmod 600 .env`. The install block of
# Vibrance's docs/operations.md does all of it for you.
#
# This file is the .env.example of MusicLib 1.2.0, unchanged, plus the blocks
# between a line `# >>> Vibrance` and the next `# <<< Vibrance`: this header
# and Vibrance's settings at the end. Its comments are MusicLib's own:
# "docs/operations.md" there is MusicLib's guide, and "the README's install
# block" is the install block of Vibrance's guide. Its last setting,
# COMPOSE_FILE=compose.dev.yaml, is for a clone of MusicLib's repository and
# does not apply to this stack.
# MusicLib's .env.example follows.
# <<< Vibrance
# Vibrance MusicLib: settings of compose.yaml. Copy this file to `.env` next
# to compose.yaml, set POSTGRES_PASSWORD and MUSICLIB_PASSWORD, then
# `chmod 600 .env`.
# docs/operations.md, "Configuration", explains every setting.

# The database password. Left empty, the DEFAULT PASSWORD `musiclib` is used:
# better set your own BEFORE THE FIRST START, for example the output of
#   openssl rand -hex 32
# (the README's install block writes one here for you). PostgreSQL reads it
# only when it creates its database, at the first start: changing it here
# later does not change the database's password, and the app can no longer
# connect (docs/operations.md, "The database password", explains how to
# change it).
POSTGRES_PASSWORD=

# The password of the web interface and the API, at least 12 characters.
# Required: MusicLib does not start without it. The README's install block
# writes a random one here (openssl rand -base64 24); read it with
#   grep MUSICLIB_PASSWORD .env
# To change it, edit it here and run `docker compose up -d --wait`: the
# restart signs every browser out. Over plain HTTP it crosses the network
# in clear: see docs/operations.md, "Access from other devices".
MUSICLIB_PASSWORD=

# The exact address you open in the browser, scheme, host and port: the API
# answers only requests for this host (localhost and 127.0.0.1 differ). Without
# a reverse proxy, keep its port equal to MUSICLIB_PORT, and its host to
# MUSICLIB_BIND for LAN access.
# Behind a reverse proxy, its https:// address, such as https://music.example.com
# (docs/operations.md, "HTTPS and a domain name").
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional settings, with their defaults.

# Address and port published on the host. Loopback only by default; for LAN
# access set the machine's address here and use it in PUBLIC_ORIGIN.
#MUSICLIB_BIND=127.0.0.1
#MUSICLIB_PORT=8080

# Host directory with the music to import, mounted read-only on /import. It
# must exist before starting: Compose does not create it.
#MUSICLIB_IMPORT=./import

# /data (originals and the generated library) and /backup: named volumes by
# default, or absolute host paths on local ext4 owned by the app's uid
# (sudo mkdir -p DIR && sudo chown 1000:1000 DIR). Create them before the
# first start, or Docker creates them owned by root: a data folder owned by
# root stops MusicLib from starting, and a backup folder owned by root makes
# every backup fail. To move an existing installation to a folder, see
# docs/operations.md, "Moving an existing installation to a host folder".
#MUSICLIB_DATA=data
#MUSICLIB_BACKUP=backup

# Number of workers, 1 to 16. Empty: max(1, min(4, CPUs)).
#WORKERS=

# The app's uid:gid. The image uses 1000:1000, and new named volumes are owned
# by it; another uid needs MUSICLIB_DATA and MUSICLIB_BACKUP as host
# directories owned by that uid.
#MUSICLIB_UID=1000
#MUSICLIB_GID=1000

# Source build only (a clone of the repository): build and run the app from
# source with compose.dev.yaml, for plain `docker compose` commands and the
# scripts/ maintenance wrappers alike.
#COMPOSE_FILE=compose.dev.yaml
# >>> Vibrance

# ---------------------------------------------------------------------------
# Vibrance. Vibrance's docs/operations.md, "Configuration", explains every
# setting.

# The password of Vibrance's first account, the admin: 12 to 1024 bytes.
# Required at the first start: Vibrance does not start without it while it
# has no account. The install block writes a random one here
# (openssl rand -base64 24); read it with
#   grep VIBRANCE_ADMIN_PASSWORD .env
# It is read only while Vibrance has no account: changing it later changes
# nothing (docs/operations.md, "The passwords and the accounts", explains how
# to change it).
VIBRANCE_ADMIN_PASSWORD=

# The exact address you open Vibrance at, scheme, host and port: Vibrance
# answers only requests for this host (localhost and 127.0.0.1 differ).
# Without a reverse proxy, keep its port equal to VIBRANCE_PORT, and its host
# to VIBRANCE_BIND for LAN access. Behind Caddy, its https:// address, such as
# https://vibrance.example.com (docs/operations.md, "HTTPS and two names").
VIBRANCE_PUBLIC_ORIGIN=http://127.0.0.1:8090

# Optional settings, with their defaults.

# The name of the first admin, read only while Vibrance has no account.
#VIBRANCE_ADMIN_USERNAME=admin

# Address and port published on the host. Loopback only by default; for LAN
# access set the machine's address here and use it in VIBRANCE_PUBLIC_ORIGIN.
#VIBRANCE_BIND=127.0.0.1
#VIBRANCE_PORT=8090

# Time between two scans of MusicLib's library: a Go duration, 30s or more.
#VIBRANCE_SCAN_INTERVAL=5m

# How many ffmpeg and ffprobe processes, and albums being indexed, at once:
# 1 to 16. Empty: max(1, min(4, CPUs)).
#VIBRANCE_WORKERS=

# Vibrance's backups (/backup in its container): a named volume by default,
# or the absolute path of a host folder owned by VIBRANCE_UID, preferably on
# another disk, never inside MusicLib's folders.
#VIBRANCE_BACKUP=vibrance_backup

# Vibrance's uid:gid, never 0. Keep 1000 unless you have a reason: another
# uid needs VIBRANCE_BACKUP as a host folder owned by it, and its state
# volume given to it (docs/operations.md, "Configuration").
#VIBRANCE_UID=1000
#VIBRANCE_GID=1000

# Caddy in front of both products (compose.caddy.yaml; docs/operations.md,
# "HTTPS and two names"): the Compose files to use, and the API token of
# your DNS provider for the certificate.
#COMPOSE_FILE=compose.yaml:compose.caddy.yaml
#CF_API_TOKEN=
# <<< Vibrance
